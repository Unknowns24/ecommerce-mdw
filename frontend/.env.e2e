# Entorno de las pruebas e2e (npm run test:e2e). Es contrato con el job e2e
# del CI: ahí solo se reemplaza DATABASE_DSN por la del service de Postgres.
# Nada de acá sirve en producción: el secreto existe solo para firmar las
# sesiones de prueba (e2e/sesiones.ts).
DATABASE_DSN=postgres://localhost:5432/bc_e2e?sslmode=disable
APP_SECRET_KEY=e2e-secreto-solo-para-pruebas-no-usar-en-produccion
ORDER_ACCESS_TOKEN_SECRET=e2e-token-pedidos-solo-para-pruebas
BOOTSTRAP_MASTER_KEY=e2e-clave-bootstrap
PAYMENT_RESERVATION_TTL=15m
ENVIRONMENT=test
APP_NAME=bc-importados-e2e
API_PORT=8481
WEB_PORT=3481
MERCADOPAGO_WEBHOOK_SECRET=e2e-webhook-solo-para-pruebas
