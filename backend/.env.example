# Copiá este archivo a backend/.env y completá los valores.
# Nunca commitees backend/.env: está en .gitignore porque es una sesión viva
# de secretos. El nombre de cada variable es el único contrato: se agrega acá
# un campo nuevo en el mismo commit en que se agrega a config/viper.go.

ENVIRONMENT=development
APP_NAME=bc-importados
APP_PORT=8080
APP_SECRET_KEY=

DATABASE_DSN=

BOOTSTRAP_MASTER_KEY=
ORDER_ACCESS_TOKEN_SECRET=
PAYMENT_RESERVATION_TTL=15m

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

FISCAL_API_BASE_URL=
FISCAL_API_TOKEN=
OPENWA_BASE_URL=
OPENWA_TOKEN=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
