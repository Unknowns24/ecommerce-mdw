@startuml
' BC Importados - modelo logico propuesto a partir de reglas confirmadas de docs/specs.md v0.1.
' PK/FK, nombres de columnas, longitudes y tipos son sugerencias tecnicas: no existe esquema fisico aprobado.
' Tipos SQL genericos; el motor/driver sigue pendiente (ADR-002).
title BC Importados - ERD logico de v1 (solo reglas confirmadas)

hide circle
skinparam linetype ortho
skinparam shadowing false
left to right direction

package "Identidad y permisos" {
  entity "usuario" as usuario {
    * id : BIGINT <<PK>>
    --
    * correo : VARCHAR(254) <<UNIQUE>>
    credencial_hash : VARCHAR(255)
    * estado : VARCHAR(30)
    * origen : VARCHAR(30)
    * es_dueno_inicial : BOOLEAN
  }
  entity "rol" as rol {
    * id : BIGINT <<PK>>
    --
    * nombre : VARCHAR(100)
  }
  entity "permiso" as permiso {
    * id : BIGINT <<PK>>
    --
    * accion : VARCHAR(150)
  }
  entity "usuario_rol" as usuario_rol {
    * usuario_id : BIGINT <<PK, FK>>
    * rol_id : BIGINT <<PK, FK>>
  }
  entity "rol_permiso" as rol_permiso {
    * rol_id : BIGINT <<PK, FK>>
    * permiso_id : BIGINT <<PK, FK>>
  }
}

package "Catalogo" {
  entity "marca" as marca {
    * id : BIGINT <<PK>>
    --
    * nombre : VARCHAR(150)
    * estado : VARCHAR(30)
  }
  entity "categoria" as categoria {
    * id : BIGINT <<PK>>
    --
    * nombre : VARCHAR(150)
    * estado : VARCHAR(30)
  }
  entity "categoria_jerarquia" as categoria_jerarquia {
    * padre_id : BIGINT <<PK, FK>>
    * hija_id : BIGINT <<PK, FK>>
  }
  entity "producto" as producto {
    * id : BIGINT <<PK>>
    --
    * marca_id : BIGINT <<FK>>
    * nombre : VARCHAR(255)
    descripcion : TEXT
    * estado : VARCHAR(30)
    * metodologia_rotacion : VARCHAR(4)
  }
  entity "producto_categoria" as producto_categoria {
    * producto_id : BIGINT <<PK, FK>>
    * categoria_id : BIGINT <<PK, FK>>
  }
  entity "variante" as variante {
    * id : BIGINT <<PK>>
    --
    * producto_id : BIGINT <<FK>>
    * codigo : VARCHAR(100)
    * nombre : VARCHAR(255)
    descripcion : TEXT
    * precio_minorista : DECIMAL(18,2)
    * precio_mayorista : DECIMAL(18,2)
    * estado : VARCHAR(30)
  }
  entity "imagen_variante" as imagen_variante {
    * id : BIGINT <<PK>>
    --
    * variante_id : BIGINT <<FK>>
    * referencia_imagen : VARCHAR(2048)
    * es_principal : BOOLEAN
  }
  entity "proveedor" as proveedor {
    * id : BIGINT <<PK>>
    --
    * nombre : VARCHAR(255)
    correo : VARCHAR(254)
    telefono : VARCHAR(50)
    web : VARCHAR(2048)
  }
}

package "Inventario y venta externa" {
  entity "lote" as lote {
    * id : BIGINT <<PK>>
    --
    * variante_id : BIGINT <<FK>>
    * proveedor_id : BIGINT <<FK>>
    * unidades_ingresadas : INTEGER
    * costo_unitario : DECIMAL(18,2)
    * fecha_ingreso : TIMESTAMP
  }
  entity "venta_externa" as venta_externa {
    * id : BIGINT <<PK>>
    --
    * responsable_id : BIGINT <<FK>>
    * fecha : TIMESTAMP
  }
  entity "detalle_venta_externa" as detalle_venta_externa {
    * id : BIGINT <<PK>>
    --
    * venta_externa_id : BIGINT <<FK>>
    * variante_id : BIGINT <<FK>>
    * unidades : INTEGER
  }
  entity "movimiento_stock" as movimiento_stock {
    * id : BIGINT <<PK>>
    --
    * lote_id : BIGINT <<FK>>
    responsable_id : BIGINT <<FK>>
    pedido_id : BIGINT <<FK>>
    detalle_venta_externa_id : BIGINT <<FK>>
    * tipo : VARCHAR(30)
    * unidades : INTEGER
    * fecha : TIMESTAMP
    motivo : TEXT
    origen : VARCHAR(100)
  }
  entity "reserva_stock" as reserva_stock {
    * id : BIGINT <<PK>>
    --
    * pedido_id : BIGINT <<FK>>
    * lote_id : BIGINT <<FK>>
    * unidades : INTEGER
    * estado : VARCHAR(30)
    vencimiento : TIMESTAMP
  }
  entity "asignacion_lote" as asignacion_lote {
    * id : BIGINT <<PK>>
    --
    * detalle_pedido_id : BIGINT <<FK>>
    * lote_id : BIGINT <<FK>>
    * unidades : INTEGER
    * costo_unitario_historico : DECIMAL(18,2)
  }
}

package "Promociones y cupones" {
  entity "promocion" as promocion {
    * id : BIGINT <<PK>>
    --
    * tipo_beneficio : VARCHAR(40)
    * prioridad : INTEGER
    cantidad_minima : INTEGER
    cantidad_maxima : INTEGER
    precio_total_combo : DECIMAL(18,2)
    precio_unitario_especial : DECIMAL(18,2)
  }
  entity "promocion_producto" as promocion_producto {
    * promocion_id : BIGINT <<PK, FK>>
    * producto_id : BIGINT <<PK, FK>>
    * incluido : BOOLEAN
  }
  entity "promocion_variante" as promocion_variante {
    * promocion_id : BIGINT <<PK, FK>>
    * variante_id : BIGINT <<PK, FK>>
    * incluido : BOOLEAN
  }
  entity "promocion_categoria" as promocion_categoria {
    * promocion_id : BIGINT <<PK, FK>>
    * categoria_id : BIGINT <<PK, FK>>
    * incluido : BOOLEAN
  }
  entity "componente_combo" as componente_combo {
    * id : BIGINT <<PK>>
    --
    * promocion_id : BIGINT <<FK>>
    * cantidad_requerida : INTEGER
  }
  entity "componente_producto" as componente_producto {
    * componente_id : BIGINT <<PK, FK>>
    * producto_id : BIGINT <<PK, FK>>
    * incluido : BOOLEAN
  }
  entity "componente_variante" as componente_variante {
    * componente_id : BIGINT <<PK, FK>>
    * variante_id : BIGINT <<PK, FK>>
    * incluido : BOOLEAN
  }
  entity "componente_categoria" as componente_categoria {
    * componente_id : BIGINT <<PK, FK>>
    * categoria_id : BIGINT <<PK, FK>>
    * incluido : BOOLEAN
  }
  entity "aplicacion_promocion" as aplicacion_promocion {
    * id : BIGINT <<PK>>
    --
    * pedido_id : BIGINT <<FK>>
    * promocion_id : BIGINT <<FK>>
    * regla_historica : TEXT
    * descuento_total : DECIMAL(18,2)
  }
  entity "aplicacion_promocion_detalle" as aplicacion_promocion_detalle {
    * aplicacion_id : BIGINT <<PK, FK>>
    * detalle_pedido_id : BIGINT <<PK, FK>>
    * unidades : INTEGER
    * descuento : DECIMAL(18,2)
  }
  entity "cupon" as cupon {
    * id : BIGINT <<PK>>
    --
    * codigo : VARCHAR(100)
    * tipo_descuento : VARCHAR(30)
    * valor : DECIMAL(18,2)
    * minimo_compra : DECIMAL(18,2)
    tope_descuento : DECIMAL(18,2)
    * maximo_usos : INTEGER
    * acumulable : BOOLEAN
    vigencia_desde : TIMESTAMP
    vigencia_hasta : TIMESTAMP
  }
  entity "uso_cupon" as uso_cupon {
    * id : BIGINT <<PK>>
    --
    * cupon_id : BIGINT <<FK>>
    * pedido_id : BIGINT <<FK, UNIQUE>>
    * estado : VARCHAR(30)
  }
}

package "Carrito y avisos" {
  entity "carrito" as carrito {
    * id : BIGINT <<PK>>
    --
    * usuario_id : BIGINT <<FK>>
  }
  entity "item_carrito" as item_carrito {
    * id : BIGINT <<PK>>
    --
    * carrito_id : BIGINT <<FK>>
    * variante_id : BIGINT <<FK>>
    * cantidad : INTEGER
  }
  entity "favorito" as favorito {
    * usuario_id : BIGINT <<PK, FK>>
    * variante_id : BIGINT <<PK, FK>>
  }
  entity "suscripcion_reposicion" as suscripcion_reposicion {
    * id : BIGINT <<PK>>
    --
    * variante_id : BIGINT <<FK>>
    * correo : VARCHAR(254)
  }
}

package "Pedidos, pagos y auditoria" {
  entity "pedido" as pedido {
    * id : BIGINT <<PK>>
    --
    usuario_id : BIGINT <<FK, NULLABLE>>
    * estado : VARCHAR(30)
    * fecha_creacion : TIMESTAMP
    * comprador_nombre : VARCHAR(150)
    * comprador_apellido : VARCHAR(150)
    * comprador_correo : VARCHAR(254)
    * comprador_telefono : VARCHAR(50)
    * comprador_dni : VARCHAR(30)
    * forma_entrega : VARCHAR(30)
    domicilio_entrega : TEXT
    distancia_vial : DECIMAL(12,3)
    * tarifa_envio_historica : DECIMAL(18,2)
    * medio_pago : VARCHAR(30)
    * subtotal_base : DECIMAL(18,2)
    * subtotal_promocionado : DECIMAL(18,2)
    * descuento_cupon : DECIMAL(18,2)
    * total : DECIMAL(18,2)
  }
  entity "detalle_pedido" as detalle_pedido {
    * id : BIGINT <<PK>>
    --
    * pedido_id : BIGINT <<FK>>
    * variante_id : BIGINT <<FK>>
    * variante_nombre_historico : VARCHAR(255)
    * variante_codigo_historico : VARCHAR(100)
    * cantidad : INTEGER
    * precio_minorista_historico : DECIMAL(18,2)
    * precio_aplicado_historico : DECIMAL(18,2)
    * descuento_historico : DECIMAL(18,2)
    * subtotal_historico : DECIMAL(18,2)
  }
  entity "intento_pago" as intento_pago {
    * id : BIGINT <<PK>>
    --
    * pedido_id : BIGINT <<FK>>
    * medio : VARCHAR(30)
    * importe : DECIMAL(18,2)
    * estado : VARCHAR(30)
    identificador_externo : VARCHAR(255)
    * fecha_creacion : TIMESTAMP
    fecha_acreditacion_cobro : TIMESTAMP
  }
  entity "factura" as factura {
    * id : BIGINT <<PK>>
    --
    * pedido_id : BIGINT <<FK>>
    referencia_externa : VARCHAR(255)
    * estado_emision : VARCHAR(30)
    resultado_externo : TEXT
  }
  entity "auditoria_pedido" as auditoria_pedido {
    * id : BIGINT <<PK>>
    --
    * pedido_id : BIGINT <<FK>>
    actor_usuario_id : BIGINT <<FK, NULLABLE>>
    * actor_tipo : VARCHAR(30)
    * fecha : TIMESTAMP
    * accion : VARCHAR(100)
    datos_anteriores : TEXT
    datos_nuevos : TEXT
  }
}

package "Tienda y entrega" {
  entity "configuracion_tienda" as configuracion_tienda {
    * id : BIGINT <<PK>>
    --
    * ubicacion_local : TEXT
    * distancia_vial_maxima : DECIMAL(12,3)
    * efectivo_habilitado : BOOLEAN
  }
  entity "tarifa_distancia" as tarifa_distancia {
    * id : BIGINT <<PK>>
    --
    * configuracion_id : BIGINT <<FK>>
    * distancia_desde : DECIMAL(12,3)
    * distancia_hasta : DECIMAL(12,3)
    * importe : DECIMAL(18,2)
  }
}

' Claves y cardinalidades derivadas de la especificacion.
usuario ||--o{ usuario_rol
rol ||--o{ usuario_rol
rol ||--o{ rol_permiso
permiso ||--o{ rol_permiso

marca ||--o{ producto
categoria ||--o{ categoria_jerarquia : padre
categoria ||--o{ categoria_jerarquia : hija
producto ||--o{ producto_categoria
categoria ||--o{ producto_categoria
producto ||--|{ variante
variante ||--o{ imagen_variante
variante ||--o{ lote
proveedor ||--o{ lote

usuario ||--o{ venta_externa : responsable
venta_externa ||--|{ detalle_venta_externa
variante ||--o{ detalle_venta_externa
lote ||--o{ movimiento_stock
usuario |o--o{ movimiento_stock : responsable humano
pedido |o--o{ movimiento_stock : pedido, si aplica
detalle_venta_externa |o--o{ movimiento_stock : salida externa
pedido ||--o{ reserva_stock
lote ||--o{ reserva_stock
detalle_pedido ||--o{ asignacion_lote
lote ||--o{ asignacion_lote

promocion ||--o{ promocion_producto
producto ||--o{ promocion_producto
promocion ||--o{ promocion_variante
variante ||--o{ promocion_variante
promocion ||--o{ promocion_categoria
categoria ||--o{ promocion_categoria
promocion ||--o{ componente_combo
componente_combo ||--o{ componente_producto
producto ||--o{ componente_producto
componente_combo ||--o{ componente_variante
variante ||--o{ componente_variante
componente_combo ||--o{ componente_categoria
categoria ||--o{ componente_categoria
promocion ||--o{ aplicacion_promocion
pedido ||--o{ aplicacion_promocion
aplicacion_promocion ||--|{ aplicacion_promocion_detalle
detalle_pedido ||--o{ aplicacion_promocion_detalle
cupon ||--o{ uso_cupon
pedido ||--o| uso_cupon : maximo un cupon

usuario ||--o{ carrito
carrito ||--o{ item_carrito
variante ||--o{ item_carrito
usuario ||--o{ favorito
variante ||--o{ favorito
variante ||--o{ suscripcion_reposicion

usuario |o--o{ pedido : compra registrada o invitada
pedido ||--|{ detalle_pedido
variante ||--o{ detalle_pedido
pedido ||--o{ intento_pago
pedido -- factura : asociada (cardinalidad pendiente)
pedido ||--o{ auditoria_pedido
usuario |o--o{ auditoria_pedido : actor humano o sistema
configuracion_tienda ||--o{ tarifa_distancia

note bottom of usuario
  El correo es unico. Los campos exactos del perfil y la politica de
  sesiones/enlaces no estan definidos. El origen distingue cuentas
  publicas de administrativas. Si estas pueden comprar: pendiente.
end note

note bottom of categoria
  La regla «maximo un padre y sin ciclos» es propuesta, no confirmada.
  categoria_jerarquia expresa la relacion documentada sin imponer
  esa restriccion. Tampoco se afirma herencia fisica a Variante.
end note

note bottom of promocion
  Se modelan los tres beneficios confirmados y objetivos incluidos/
  excluidos. Quedan sin cerrar la evaluacion de tramos, desempates y
  repeticion de combos (RFC-005); no se fijan esas restricciones.
end note

note bottom of pedido
  Datos del comprador, precios y entrega son copias historicas.
  usuario_id es opcional para invitados. Estados definitivos y
  conciliacion/cancelacion tardia siguen abiertos (RFC-004).
end note

note bottom of factura
  No se impone unicidad por pedido: numero de documentos, contrato
  fiscal e idempotencia siguen pendientes (RFC-004/RFC-006).
end note

note bottom of configuracion_tienda
  Unidad y fronteras exactas de los rangos de distancia pendientes.
  El pedido conserva la tarifa y distancia cotizadas.
end note

legend bottom
  PK/FK y tipos son sugerencias de modelo logico, no decisiones del
  equipo sobre motor SQL. Los atributos de implementacion sin contrato
  definido (tokens, sesiones, invitaciones e integraciones) no se
  convierten en tablas aqui. Invitados guardan carrito/favoritos localmente.
  No se incluyen RFC futuros fuera de v1.
endlegend
@enduml
